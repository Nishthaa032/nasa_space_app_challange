# Copy this file to .env. Keep it outside frontend/ and never paste the token in chat.
EARTHDATA_TOKEN=
# Optional custom cache directory. Defaults to local ./data/monitor_cache if unset.
SARSCOPE_CACHE_DIR="data/monitor_cache"
# Maximum HTTP bytes per acquisition; stops rather than fetching full files.
SARSCOPE_TRANSFER_MB=256
SARSCOPE_CACHE_GB=10
# User-triggered place search; no autocomplete or periodic geocoding.
SARSCOPE_GEOCODER_URL=https://photon.komoot.io/api/
